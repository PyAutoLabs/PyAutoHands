#!/usr/bin/env bash
# autohands — unified bash CLI for PyAutoHands operations.
#
# Run `autohands help` for the list of subcommands.
# Run `autohands help <subcommand>` for full details on one subcommand.
#
# Recommended alias for ~/.bashrc:
#   alias autohands-help='$HOME/Code/PyAutoLabs/PyAutoHands/bin/autohands help'

set -u

SELF="$(readlink -f "$0")"
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
PYAUTOBASE="$(cd "$REPO/.." && pwd)"
AUTOHANDS_DIR="$REPO/autohands"
ADMIN_JAMMY="$PYAUTOBASE/admin_jammy"

# ----- subcommand registration -----
#
# SUBCOMMAND_ORDER drives the layout of `autohands help`. Entries beginning
# with "# " are rendered as section headers; everything else is a real
# subcommand and must have a matching SHORT_DESC entry plus cmd_<name> and
# help_<name> functions.
#
# Together with INTERNAL_MODULES below, this is the complete registry of
# autohands/: every module there is either a subcommand here or an internal
# module listed there. tests/test_autohands_registry.py enforces it.

SUBCOMMAND_ORDER=(
  "# Build and release pipeline"
  pre_build
  "# Release validation"
  verify_install
  url_check
  bump_colab_urls
  "# Workspace operations (run from a workspace root)"
  generate
  generate_markdown
  regenerate_navigator
  run
  run_python
  run_all
  "# Workspace guards (CI-invoked; runnable locally)"
  check_navigator
  check_search_memory
  check_dataset_allowlist
  validate_env_profiles
  "# Release support"
  board
  script_matrix
  aggregate_results
  slow_skip_check
  generate_release_notes
  slack_release_notes
  create_analysis_issue
  tag_and_merge
  tombstone
  "# Assistant seeding"
  clone_seed
  "# Triage support"
  repro_command
  "# Monitoring daemon (delegates to PyAutoHeart)"
  watch
  status
  tick
  fix
  "# Meta"
  help
)

declare -A SHORT_DESC=(
  [pre_build]="Format, generate, push workspaces, then dispatch release.yml"
  [verify_install]="Shim → pyauto-heart verify_install (deep install-path checks)"
  [url_check]="Shim → pyauto-heart url_check (forbidden Binder/Colab URL guard)"
  [bump_colab_urls]="Rewrite Colab URLs in cwd from old date-tag to new date-tag"
  [generate]="Convert workspace scripts/ to notebooks/ (run from a workspace root)"
  [generate_markdown]="Render curated workspace scripts to executed markdown pages with figures"
  [regenerate_navigator]="Rebuild a workspace's llms-full.txt + workspace_index.json catalogue"
  [check_navigator]="Guard: navigator/instruction path references all resolve on disk"
  [check_search_memory]="Guard: every MultiStart* search in a workspace sets batch_size explicitly"
  [check_dataset_allowlist]="Guard: tracked dataset/ files are covered by the .gitignore allowlist"
  [validate_env_profiles]="Guard: a workspace's smoke/release env profiles parse and resolve"
  [run]="Execute notebooks in a workspace folder"
  [run_python]="Execute Python scripts in a workspace folder"
  [run_all]="Run scripts across one or more workspaces and produce summary reports"
  [board]="The release board — what shipped (versions, train runs); --md/--md-brief/--html/--json/--badge"
  [script_matrix]="Output a JSON matrix of {name, directory} for GitHub Actions"
  [aggregate_results]="Aggregate per-job JSON results into a release-readiness report"
  [slow_skip_check]="Surface SLOW / NEEDS_FIX entries in workspace no_run.yaml files"
  [generate_release_notes]="Generate release notes from merged PRs and create GitHub Releases"
  [slack_release_notes]="Convert a release body into the #pipreleases Slack payload"
  [create_analysis_issue]="Open a GitHub issue with the release report and assign Copilot"
  [tag_and_merge]="Commit and tag every library repo for a release"
  [tombstone]="Build the sub-floor tombstone sdists that redirect users to a supported release"
  [clone_seed]="Build (and optionally push) an assistant seed repo from a clone plan"
  [repro_command]="Emit the shell command autohands uses to run one script (for triage handoffs)"
  [watch]="Start the PyAutoHeart monitoring daemon (Ctrl-C to stop)"
  [status]="Print the latest PyAutoHeart state cache with green/yellow/red"
  [tick]="Force one PyAutoHeart refresh cycle"
  [fix]="Bundle context for a Heart failure topic and emit a Claude invocation"
  [help]="List subcommands or show details for one"
)

# Modules in autohands/ that are deliberately NOT CLI verbs. Every *.py there
# must be a registered subcommand above or listed here — the completeness rule
# tests/test_autohands_registry.py enforces. Keep the reason on the line.
INTERNAL_MODULES=(
  add_notebook_quotes   # docstring->cell transform stage; its __main__ is a debug aid
  run_notebook          # per-notebook worker subprocess spawned by run.py
  navigator             # catalogue library behind regenerate_navigator / check_navigator
  build_util            # shared py_to_notebook machinery
  env_config            # env-profile resolution library
  result_collector      # per-run JSON result library
  generate_autofit      # generate.py's autofit-specific branch
)

# _python_in_autohands <script> [args...]
# Run a Python tool from autohands/ with PYTHONPATH set so its sibling
# modules (build_util, generate_autofit, env_config, result_collector)
# resolve correctly. Inherits the user's cwd unchanged — several tools
# (run.py, run_python.py, generate.py) read config from cwd.
_python_in_autohands() {
  local script="$1"
  shift
  PYTHONPATH="$AUTOHANDS_DIR${PYTHONPATH:+:$PYTHONPATH}" \
    python "$AUTOHANDS_DIR/$script" "$@"
}

# ----- Build and release pipeline -----

help_pre_build() {
  cat <<'EOF'
autohands pre_build [minor_version]

Require a clean PyAutoHands main, then run black + generate notebooks + commit
and push for every workspace repo before dispatching release.yml. PyAutoHands
itself is never staged or committed by this command.

Arguments:
  minor_version  Minor version suffix appended to YYYY.M.D (default: 1)

This is the bash entry point wrapped by the pre_build skill.
EOF
}
cmd_pre_build() {
  bash "$REPO/pre_build.sh" "$@"
}

# ----- Release validation -----

help_verify_install() {
  cat <<'EOF'
autohands verify_install [CHECKS...] [--version VERSION] [--testpypi]
                         [--find-links DIR] [--keep]

Shim → `pyauto-heart verify_install`. Release-readiness checking is Heart's
job now (PyAutoHands is a pure executor), so this delegates to PyAutoHeart,
which owns the install-path checks (pip, conda & Colab, A–F) and writes the JSON
sidecar that `pyauto-heart readiness` consumes.

See `pyauto-heart help verify_install` for full docs.
EOF
}
cmd_verify_install() {
  local heart_bin
  heart_bin="$(_heart_resolve)" || return $?
  exec "$heart_bin" verify_install "$@"
}

help_url_check() {
  cat <<'EOF'
autohands url_check [directory]

Shim → `pyauto-heart url_check`. URL hygiene is PyAutoHeart's job now
(PyAutoHands is a pure executor). Scans rst/md/ipynb/py under <directory>
(default cwd) for forbidden Binder/Colab/owner URL patterns.

The ecosystem-wide sweep runs from PyAutoHeart's central url-check.yml
workflow; see `pyauto-heart help url_sweep`.
EOF
}
cmd_url_check() {
  local heart_bin
  heart_bin="$(_heart_resolve)" || return $?
  exec "$heart_bin" url_check "$@"
}

help_bump_colab_urls() {
  cat <<'EOF'
autohands bump_colab_urls <new-tag>

Rewrite every URL of the form
  colab.research.google.com/github/PyAutoLabs/<repo>/blob/<old-tag>/...
to use <new-tag>, in-place across *.rst, *.md, *.ipynb, *.py under cwd.

<repo> must be one of: autofit_workspace, autogalaxy_workspace,
autolens_workspace, HowToGalaxy, HowToLens, HowToFit.
<new-tag> must look like YYYY.M.D.B. Idempotent.

Called by the release.yml `release_workspaces` and `bump_library_colab_urls`
jobs so README/docs Colab links always pin to the just-released tag.
EOF
}
cmd_bump_colab_urls() {
  bash "$AUTOHANDS_DIR/bump_colab_urls.sh" "$@"
}

# ----- Workspace operations -----

help_generate() {
  cat <<'EOF'
autohands generate <project> [--report-dir DIR]

Convert every script in scripts/ to a Jupyter notebook in notebooks/, run
from inside the workspace root. The <project> argument selects the Colab
setup cell injected into each generated notebook.

Arguments:
  project        Project name (e.g. autofit, autogalaxy, autolens, howtolens)
  --report-dir   Directory to write structured JSON generation results to

Run from the workspace root, not from PyAutoHands.
EOF
}
cmd_generate() {
  _python_in_autohands generate.py "$@"
}

help_generate_markdown() {
  cat <<'EOF'
autohands generate_markdown <project> [--only SUBSTRING] [--optimize-only]

Render the scripts listed in the workspace's config/build/markdown_examples.yaml
to *executed* markdown pages under markdown/, with output figures extracted as
PNGs alongside, plus a markdown/README.md index. Run from the workspace root.

Arguments:
  project         Project name (e.g. autofit, autogalaxy, autolens)
  --only          Substring filter on the configured script paths
  --optimize-only Skip rendering; re-encode the PNGs of already-committed pages

Manual / at-release only, never per-commit — it runs the science for real.
Refuses to start under PYAUTO_TEST_MODE (a truncated search makes wrong
images); model-fit scripts resume from the completed output/ cache instead.
Rules and rationale are in the module docstring; see docs/internals.md.
EOF
}
cmd_generate_markdown() {
  _python_in_autohands generate_markdown.py "$@"
}

help_regenerate_navigator() {
  cat <<'EOF'
autohands regenerate_navigator [project]

Rebuild the workspace catalogue — llms-full.txt and workspace_index.json — for
the workspace in the current directory, without regenerating notebooks and
without the science stack (needs only pyyaml). Run from the workspace root.

Arguments:
  project        Generator project (default: $NAVIGATOR_PROJECT, else autolens)

This is the entry point the navigator_check.yml staleness job uses, and the one
to run locally when a catalogue has drifted from its scripts.
EOF
}
cmd_regenerate_navigator() {
  _python_in_autohands regenerate_navigator.py "$@"
}

help_run() {
  cat <<'EOF'
autohands run <project> <directory> [--visualise] [--report-dir DIR] [--env-config FILE]

Execute Jupyter notebooks in <directory> for <project>, skipping files
listed in the workspace's config/build/no_run.yaml (required).

Arguments:
  project        Project name (e.g. autofit, autogalaxy, autolens)
  directory      Subdirectory of notebooks/ to execute
  --visualise    Only run notebooks listed in the workspace's
                 config/build/visualise_notebooks.yaml (selects nothing
                 if the workspace has no such file)
  --report-dir   Directory to write structured JSON results to
  --env-config   Path to env_vars.yaml for per-script environment config

Run from the workspace root.
EOF
}
cmd_run() {
  _python_in_autohands run.py "$@"
}

help_run_python() {
  cat <<'EOF'
autohands run_python <project> <directory> [--report-dir DIR] [--env-config FILE]
                    [--list FILE]

Execute Python scripts in <directory> for <project>, skipping files
listed in config/build/no_run.yaml.

Arguments:
  project        Project name (e.g. autofit, autogalaxy, autolens)
  directory      Subdirectory of scripts/ to execute
  --report-dir   Directory to write structured JSON results to
  --env-config   Path to env_vars.yaml for per-script environment config
  --list         Script list (e.g. a workspace's smoke_tests.txt). Given, only
                 the listed scripts run, in the list's order (opt-in coverage);
                 omitted, scripts are discovered recursively under <directory>
                 (opt-out coverage). no_run.yaml applies either way, and wins.

Run from the workspace root.
EOF
}
cmd_run_python() {
  _python_in_autohands run_python.py "$@"
}

help_run_all() {
  cat <<'EOF'
autohands run_all [WORKSPACE...] [--results-dir DIR] [--timeout-secs N]

Run workspace scripts across one or more workspaces and produce summary
reports.

Arguments (positional):
  autofit | autogalaxy | autolens | autofit_test | autogalaxy_test | autolens_test
  | howtofit | howtogalaxy | howtolens | euclid
  (default: all ten)

Options:
  --results-dir    Override default output dir (default:
                   PyAutoHands/test_results/runs/<UTC-timestamp>/, with a
                   sibling `latest` symlink)
  --timeout-secs   Per-script timeout in seconds (default: 300)

Each workspace also gets a test_report.md in its root for easy access.
EOF
}
cmd_run_all() {
  _python_in_autohands run_all.py "$@"
}

# ----- Workspace guards -----
#
# CI gates that a maintainer can also run locally to reproduce a red check.
# Note the input contracts differ: --root, a positional path, or plain cwd.

help_check_navigator() {
  cat <<'EOF'
autohands check_navigator [--root DIR] [--banners warn|fail] [--ignore-file FILE]

Guard: every scripts/... and notebooks/... reference in a workspace's navigator
and instruction files resolves on disk (literal paths must exist; globs must
match at least one file), plus a banner-comment lint. Markdown files are also
scanned for folder references relative to their own location.

Arguments:
  --root         Workspace root to check (default: current directory)
  --banners      Banner lint mode: fail (nonzero exit) or warn (default: fail)
  --ignore-file  Ignore file of paths/globs

Runs in CI from .github/workflows/navigator_check.yml.
EOF
}
cmd_check_navigator() {
  _python_in_autohands check_navigator.py "$@"
}

help_check_search_memory() {
  cat <<'EOF'
autohands check_search_memory --root DIR [--scripts-dir DIR]

Guard: every af.MultiStart* search in a workspace's scripts sets batch_size
explicitly. The default (batch_size=None) vmaps all 48 starts at once, which
for a memory-heavy likelihood wants ~86 GB and took down two nightly runs in
2026-07 (PyAutoFit#1452). Writing batch_size=None passes — the rule is that the
memory decision is typed out where a reviewer sees it, not arrived at by
defaulting.

Arguments:
  --root         Workspace root (required)
  --scripts-dir  Scripts directory relative to root (default: scripts)

Runs in CI from .github/workflows/navigator_check.yml.
EOF
}
cmd_check_search_memory() {
  _python_in_autohands check_search_memory.py "$@"
}

help_check_dataset_allowlist() {
  cat <<'EOF'
autohands check_dataset_allowlist

Guard: every tracked file under dataset/ in the workspace is covered by that
workspace's .gitignore allowlist (the !dataset/... re-include lines), so a
force-committed simulated dataset fails the build instead of shipping ~10 MB of
runtime-generated data to users. Takes no arguments — operates on the current
directory, so run it from the workspace root.

Allowlist-based, not git check-ignore-based (which never flags an
already-tracked file). A workspace with no !dataset/... re-includes has not
adopted the regime yet and is skipped with a notice.

Runs as a leg of pre_build.sh.
EOF
}
cmd_check_dataset_allowlist() {
  _python_in_autohands check_dataset_allowlist.py "$@"
}

help_validate_env_profiles() {
  cat <<'EOF'
autohands validate_env_profiles <workspace> [--strict-derivation]
                                [--strict-markers] [--strict-declarations]

Guard: parse both of a workspace's env profiles (config/build/profile_smoke.yaml
and profile_release.yaml), resolve every script under each, and fail on config
errors that would otherwise surface only as the next nightly's red run — a
profile that will not parse, unknown keys, malformed or dead overrides, bad
__Env__ declarations, resolver round-trip failures. A legacy env_vars*.yaml in
config/build/ is itself an error.

Takes the workspace root as a positional path (not --root); the --strict-*
flags promote the corresponding warning tiers to errors.

Runs in CI from PyAutoHeart's smoke-tests.yml.
EOF
}
cmd_validate_env_profiles() {
  _python_in_autohands validate_env_profiles.py "$@"
}

# ----- Release support -----

help_script_matrix() {
  cat <<'EOF'
autohands script_matrix <project...>

Print a JSON matrix of {name, directory} pairs for GitHub Actions matrix
strategy. <project> arguments are workspace names whose scripts/ directory
will be enumerated.

Used by release.yml to dynamically generate the run_scripts and
run_notebooks job matrices.
EOF
}
help_board() { cat <<EOF
autohands board [--md|--md-brief|--html|--json|--badge]
                [--collect OUT] [--snapshot F]

The release board — a phone-readable record of WHAT THE HANDS SHIPPED:
released library versions (from git tags, the authoritative record), their
PyPI liveness, the release train's recent runs, and the nightly driver's
outcomes. Past tense by design: whether it is SAFE to release lives with the
Heart, whose board the page links.

Formats (default --md):
  --md        the full markdown board
  --md-brief  the one-line README strip (between the hands:begin/end markers)
  --html      the GitHub Pages page, with one-tap 📋 copy buttons holding the
              Claude Code commands (/release, /release rehearse,
              /release validate, /build; failed runs copy a /bug prompt)
  --json      the machine surface
  --badge     a shields.io endpoint-badge JSON (released version + age)

  --collect OUT   gather a snapshot (GitHub + PyPI APIs) to OUT and exit
  --snapshot F    render from a previously collected snapshot (no network)

Published automatically by .github/workflows/release_board.yml after every
"PyAuto Release" run and daily.
EOF
}
cmd_board() {
  _python_in_autohands board.py "$@"
}

cmd_script_matrix() {
  _python_in_autohands script_matrix.py "$@"
}

